---
import Base from '../layouts/Base.astro';
import { PackagesPage } from '../components/pages/PackagesPage';
import { getEntry } from 'astro:content';

const page = await getEntry('pages', 'packages');
const d = page.data;
---

<Base title={d.seo_title ?? d.title} description={d.seo_description}>
  <PackagesPage
    client:load
    heroHeading={d.hero_heading}
    heroSubheading={d.hero_subheading}
    rateFoundations={d.rate_foundations}
    rateRetainer={d.rate_retainer}
    rateAdvocacy={d.rate_advocacy}
    rateAdmin={d.rate_admin}
    rateMileage={d.rate_mileage}
  />
</Base>
