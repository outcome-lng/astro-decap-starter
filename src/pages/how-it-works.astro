---
import Base from '../layouts/Base.astro';
import { HowItWorksPage } from '../components/pages/HowItWorksPage';
import { getEntry } from 'astro:content';

const page = await getEntry('pages', 'how-it-works');
const d = page.data;
---

<Base title={d.seo_title ?? d.title} description={d.seo_description}>
  <HowItWorksPage
    client:load
    heroHeading={d.hero_heading}
    heroSubheading={d.hero_subheading}
  />
</Base>
