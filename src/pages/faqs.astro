---
import Base from '../layouts/Base.astro';
import { FaqsPage } from '../components/pages/FaqsPage';
import { getEntry } from 'astro:content';

const page = await getEntry('pages', 'faqs');
const d = page.data;
---

<Base title={d.seo_title ?? d.title} description={d.seo_description}>
  <FaqsPage
    client:load
    heroHeading={d.hero_heading}
    heroSubheading={d.hero_subheading}
    faqCategories={d.faq_categories}
  />
</Base>
