---
interface Props {
  heading?: string;
  subheading?: string;
  image?: string;
  buttonText?: string;
  buttonUrl?: string;
}

const { heading, subheading, image, buttonText, buttonUrl } = Astro.props;
---

{heading && (
  <section
    class="relative bg-gray-50 py-20 md:py-28"
    style={image ? `background-image: url('${image}'); background-size: cover; background-position: center;` : undefined}
  >
    {image && <div class="absolute inset-0 bg-white/80" />}
    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 text-center">
      <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">{heading}</h1>
      {subheading && (
        <p class="text-lg text-gray-600 mb-8 max-w-2xl mx-auto">{subheading}</p>
      )}
      {buttonText && (
        <a
          href={buttonUrl ?? '#'}
          class="inline-block bg-gray-900 text-white px-6 py-3 rounded text-sm font-medium hover:bg-gray-700 transition-colors"
        >
          {buttonText}
        </a>
      )}
    </div>
  </section>
)}
